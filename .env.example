# Google OAuth client ID (from Google Cloud Console, OAuth 2.0 Client — type: iOS/Android/Web as needed)
GOOGLE_CLIENT_ID=

# Note: the Anthropic Claude API key is NOT stored here.
# Users enter it in the app's Settings screen; it is kept in expo-secure-store.

# Dev Gemini API key (free tier, aistudio.google.com) — used ONLY for the daily
# writing prompt when the user hasn't connected their own key.
EXPO_PUBLIC_GEMINI_API_KEY=
